# AgriScout 后端配置示例：复制为 .env 后按需修改
APP_NAME=AgriScout
VERSION=0.1.0
ENVIRONMENT=dev
# 开发期默认 SQLite；生产切换为 PostgreSQL，例如：
# DATABASE_URL=postgresql+psycopg://agriscout:agriscout@localhost:5432/agriscout
DATABASE_URL=sqlite:///./agriscout.db
# 允许跨域的前端地址，逗号分隔
CORS_ORIGINS=http://localhost:5173
# 登录令牌签名密钥（决策 D15）：非 dev 环境必填，否则拒绝启动；用长随机串，例如
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_SECRET=
# 令牌有效期（小时）
AUTH_TOKEN_HOURS=12
# 识别引擎：placeholder（颜色统计，默认）| yolo（需 pip install -r requirements-ml.txt）
# ANALYZER_BACKEND=yolo
# 麦穗检测模型（ml/train.py 训练、ml/export_model.py 导出；留空 = 不数穗，长势沿用颜色统计）
# YOLO_MODEL_PATH=./models/wheat-yolo-v1.pt
# 条锈病图块分类模型（ml/train_rust.py 训练、ml/export_model.py --kind rust 导出；留空 = 不启用）
# DISEASE_MODEL_PATH=./models/rust-cls-v1.pt
# 可训练风险模型（risk-lr-*）的模型文件目录，文件名为 <版本号>.json（训练产物，不入库）
# 训练：.venv/bin/python -m app.tools.train_risk_lr --truth ../simulator/out/season-truth-field1.json
RISK_MODEL_DIR=./models
