# AgriScout 后端配置示例：复制为 .env 后按需修改
APP_NAME=AgriScout
VERSION=0.1.0
ENVIRONMENT=dev
# 开发期默认 SQLite；生产切换为 PostgreSQL，例如：
# DATABASE_URL=postgresql+psycopg://agriscout:agriscout@localhost:5432/agriscout
DATABASE_URL=sqlite:///./agriscout.db
# 允许跨域的前端地址，逗号分隔
CORS_ORIGINS=http://localhost:5173
# 可训练风险模型（risk-lr-*）的模型文件目录，文件名为 <版本号>.json（训练产物，不入库）
# 训练：.venv/bin/python -m app.tools.train_risk_lr --truth ../simulator/out/season-truth-field1.json
RISK_MODEL_DIR=./models
